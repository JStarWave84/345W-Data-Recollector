# Copiar a .env y completar. El .env esta en .gitignore.
#
# VITE_SUPABASE_URL: la URL del proyecto.
# VITE_SUPABASE_ANON_KEY: SOLO la clave publicable (sb_publishable_...).
#   Dashboard -> Project Settings -> API Keys.
#   NUNCA la sb_secret_ ni la service_role: se empaquetan en el binario de
#   Tauri y con ellas se saltea toda la RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<...>
